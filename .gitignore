# OS artifacts
.DS_Store

# Editor/tool droppings
*.log

# Python bytecode. The commit-shape gate imports the token-diff script on every
# commit (hooks/commit-shape-gate.py), so CPython writes a cache next to that
# script and every commit here would otherwise leave the tree dirty.
__pycache__/
*.pyc

# Local Claude Code state (per-user, never shared)
.claude/settings.local.json

# NOTE: deliberately no blanket `*.json` ignore — the plugin and marketplace
# manifests (.claude-plugin/marketplace.json, plugins/harness/.claude-plugin/plugin.json)
# are JSON and must stay tracked.
